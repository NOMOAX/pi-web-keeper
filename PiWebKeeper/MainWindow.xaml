<Window x:Class="PiWebKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pi Web Keeper"
        Width="640"
        MinWidth="640"
        Height="480"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
    <DockPanel Margin="14">

        <!-- 操作区：一行四个按钮（启动 / 停止、更新、重启程序、退出）。
             窗口宽度写死 640（Width 与 MinWidth，见 Window）：这一行本身比它窄得多，
             所以 WrapPanel 永远不会真的折行 —— 它只是兜底。面板自身不留间距：按钮自己的外边距就是行间距，两处都留会变成双倍。 -->
        <WrapPanel DockPanel.Dock="Top"
                   Orientation="Horizontal">

            <!-- 服务按钮：服务没在跑时是“启动”，在跑就是“停止”，文字随状态变化 -->
            <Button x:Name="ServiceButton"
                    Content="启动"
                    Width="80"
                    Height="40"
                    Click="OnServiceButtonClicked" />

            <!-- 更新按钮：跑的是两条写死的命令（见 MainWindow.RunUpdateAsync）。
                 文字写在这里；外边距与提示语由 ApplyButtonDetails 统一设定。 -->
            <Button x:Name="UpdateButton"
                    Content="更新"
                    Width="80"
                    Height="40"
                    Click="OnUpdateButtonClicked" />

            <!-- 重启程序按钮：结束本程序再重新拉起，服务跟着一起重启（见 MainWindow.LeaveAsync） -->
            <Button x:Name="RestartButton"
                    Content="重启程序"
                    Width="80"
                    Height="40"
                    Click="OnRestartButtonClicked" />

            <!-- 退出按钮：和托盘菜单里的“退出”是同一件事（同一个处理函数） -->
            <Button x:Name="ExitButton"
                    Content="退出"
                    Width="80"
                    Height="40"
                    Click="OnExitButtonClicked" />

        </WrapPanel>

        <!-- 消息框：就是这一块只读文本框本身，没有外层容器，没有标题。
             它默认的边框已经是面板的边界，外面再套一层只会白占一圈位置。 -->
        <TextBox x:Name="MessageBox"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 IsUndoEnabled="False"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 HorizontalScrollBarVisibility="Disabled"
                 VerticalScrollBarVisibility="Auto"
                 Padding="4"
                 FontFamily="NSimSun"
                 FontSize="12"
                 TextOptions.TextFormattingMode="Display">

            <!-- 右键菜单：前三项是文本框原本就有的，文字与快捷键由命令自带（复制 / Ctrl+C）。
                 下面两项是本程序加的：一条分隔线，一条“清空”。 -->
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                    <Separator />
                    <MenuItem Header="清空"
                              Click="OnClearMessageClicked" />
                </ContextMenu>
            </TextBox.ContextMenu>

        </TextBox>

    </DockPanel>
</Window>